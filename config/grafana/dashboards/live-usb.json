{
  "uid": "osprey-usb-live",
  "title": "Osprey Racing - Live USB Telemetry",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "tags": [
    "osprey-racing",
    "live",
    "usb"
  ],
  "timezone": "browser",
  "time": {
    "from": "now-5m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Input",
        "type": "custom",
        "query": "Simulation : simulation,USB receiver : usb",
        "current": {
          "text": "Simulation",
          "value": "simulation"
        },
        "options": [
          {
            "text": "Simulation",
            "value": "simulation",
            "selected": true
          },
          {
            "text": "USB receiver",
            "value": "usb",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Live receiver",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Choose **Simulation** for generated readings or **USB receiver** for the car's data. Run the Python receiver while viewing this page. The cards need readings within the last **10 seconds**; graphs show the selected time range. Pressure units are awaiting confirmation. This stream has throttle and brake pressure, not RPM."
      }
    },
    {
      "id": 2,
      "title": "Throttle \u00c2\u00b7 latest",
      "type": "stat",
      "pluginVersion": "13.2.3",
      "datasource": {
        "type": "influxdb",
        "uid": "osprey_usb"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "osprey_usb"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -10s)\n  |> filter(fn: (r) => r._measurement == \"vehicle\" and r._field == \"throttle_pct\" and r.source == \"${source}\")\n  |> group(columns: [\"device\", \"_field\"])\n  |> sort(columns: [\"_time\"])\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"device\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "noValue": "No recent data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#FF9830"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Brake pressure \u00c2\u00b7 latest (raw)",
