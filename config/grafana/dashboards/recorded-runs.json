    {
      "id": 25,
      "type": "stat",
      "title": "Best complete valid lap",
      "datasource": {
        "type": "postgres",
        "uid": "osprey_csv"
      },
      "gridPos": {
        "x": 18,
        "y": 13,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "osprey_csv"
          },
          "rawSql": "WITH points AS (\n SELECT elapsed_s,\n max(value) FILTER (WHERE channel='Lap Number') AS lap,\n max(value) FILTER (WHERE channel='Lap Invalidated') AS invalid\n FROM samples WHERE run_id=(${run:sqlstring})::bigint AND channel IN ('Lap Number','Lap Invalidated')\n GROUP BY elapsed_s\n), boundaries AS (\n SELECT *, lag(lap) OVER (ORDER BY elapsed_s) AS previous_lap FROM points WHERE lap IS NOT NULL\n), segments AS (\n SELECT *, sum(CASE WHEN previous_lap IS DISTINCT FROM lap THEN 1 ELSE 0 END) OVER (ORDER BY elapsed_s) AS segment FROM boundaries\n), laps AS (\n SELECT segment, min(lap) AS lap, min(elapsed_s) AS start_s, max(elapsed_s) AS last_s,\n coalesce(max(invalid),0)>0 AS invalid FROM segments GROUP BY segment\n), durations AS (\n SELECT *, lead(start_s) OVER (ORDER BY segment)-start_s AS duration_s,\n lead(lap) OVER (ORDER BY segment) AS next_lap FROM laps\n), classified AS (\n SELECT *, coalesce(segment>1 AND next_lap=lap+1, false) AS complete FROM durations\n) SELECT to_char((min(duration_s) FILTER (WHERE complete AND NOT invalid)) * interval '1 second', 'MI:SS.MS') AS \"Best complete lap\" FROM classified",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "string",
          "noValue": "No complete lap"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/.*/",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
