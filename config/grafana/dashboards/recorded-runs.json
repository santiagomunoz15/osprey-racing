    {
      "id": 20,
      "type": "table",
      "title": "Session details",
      "datasource": {
        "type": "postgres",
        "uid": "osprey_csv"
      },
      "gridPos": {
        "x": 18,
        "y": 3,
        "w": 6,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "osprey_csv"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT 'Run' AS \"Detail\", name AS \"Value\" FROM runs WHERE id=(${run:sqlstring})::bigint UNION ALL SELECT 'Start (UTC)', to_char(started_at AT TIME ZONE 'UTC','YYYY-MM-DD HH24:MI:SS') FROM runs WHERE id=(${run:sqlstring})::bigint UNION ALL SELECT 'Logger timezone',source_timezone FROM runs WHERE id=(${run:sqlstring})::bigint UNION ALL SELECT 'Sample rate',sample_rate::text || ' Hz' FROM runs WHERE id=(${run:sqlstring})::bigint UNION ALL SELECT key,value FROM runs r CROSS JOIN LATERAL jsonb_each_text(r.metadata) WHERE r.id=(${run:sqlstring})::bigint AND key IN ('Venue','Vehicle','Driver','Session','Comment')"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
