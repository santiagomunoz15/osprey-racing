{
  "uid": "osprey-recorded",
  "title": "Osprey Racing \u2014 Recorded Runs",
  "schemaVersion": 39,
  "version": 9,
  "editable": true,
  "timezone": "browser",
  "tags": [
    "osprey-racing",
    "recorded-runs",
    "telemetry"
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "run",
        "type": "query",
        "label": "Run",
        "datasource": {
          "type": "postgres",
          "uid": "osprey_csv"
        },
        "query": "SELECT name || ' \u2014 ' || started_at::text AS __text, id::text AS __value FROM runs ORDER BY started_at DESC",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "options": [
          {
            "text": "bristol",
            "value": "1",
            "selected": true
          }
        ],
        "current": {
          "text": "bristol",
          "value": "1"
        }
      },
      {
        "name": "reference",
        "type": "query",
        "label": "Compare with",
        "datasource": {
          "type": "postgres",
          "uid": "osprey_csv"
        },
        "query": "SELECT __text, __value FROM (SELECT 'None' AS __text, '0' AS __value, 0 AS sort_order UNION ALL SELECT name || ' - ' || started_at::text, id::text, 1 FROM runs) choices ORDER BY sort_order, __text",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "None",
          "value": "0"
        },
        "options": [
          {
            "text": "None",
            "value": "0",
            "selected": true
          }
        ]
      },
      {
        "name": "axis",
        "type": "custom",
        "label": "Horizontal axis",
        "query": "Elapsed time (s) : time,Distance (m) : distance",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "Elapsed time (s)",
          "value": "time"
        },
        "options": [
          {
            "text": "Elapsed time (s)",
            "value": "time",
            "selected": true
          },
          {
            "text": "Distance (m)",
            "value": "distance",
            "selected": false
          }
        ]
      },
      {
        "name": "channel",
        "type": "query",
        "label": "Extra channel",
        "datasource": {
          "type": "postgres",
          "uid": "osprey_csv"
        },
        "query": "SELECT name || ' [' || unit || ']' AS __text, name AS __value FROM channels WHERE run_id=(${run:sqlstring})::bigint ORDER BY name",
        "refresh": 1,
        "sort": 0,
        "multi": false,
        "includeAll": false,
        "options": [
          {
            "text": "Engine RPM [rpm]",
            "value": "Engine RPM",
            "selected": true
          }
        ],
        "current": {
          "text": "Engine RPM [rpm]",
          "value": "Engine RPM"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Recorded telemetry workspace",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "Choose a **Run**, optional **Compare with** run, and **Horizontal axis**. Colored traces are the selected run; gray traces are the reference. Time is aligned to each run's first sample; distance uses the CSV Distance channel in metres. Graphs show complete runs independently of the global time picker. Missing channels appear empty. Comparisons are whole runs, without lap alignment."
      }
    },
    {
      "id": 10,
      "type": "xychart",
      "title": "Speed \u00b7 km/h",
      "datasource": {
        "type": "postgres",
        "uid": "osprey_csv"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 18,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "osprey_csv"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN ${axis:sqlstring} = 'distance' THEN max(s.value) FILTER (WHERE s.channel = 'Distance') ELSE s.elapsed_s - min(s.elapsed_s) OVER () END AS \"Position\",\ncoalesce(max(s.value) FILTER (WHERE s.channel = 'Corr Speed'), max(s.value) FILTER (WHERE s.channel = 'Ground Speed')) AS \"Speed / selected\"\nFROM samples s WHERE s.run_id = (${run:sqlstring})::bigint\nGROUP BY s.elapsed_s ORDER BY s.elapsed_s",
          "datasourceUid": "osprey_csv"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "postgres",
            "uid": "osprey_csv"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE WHEN ${axis:sqlstring} = 'distance' THEN max(s.value) FILTER (WHERE s.channel = 'Distance') ELSE s.elapsed_s - min(s.elapsed_s) OVER () END AS \"Position\",\ncoalesce(max(s.value) FILTER (WHERE s.channel = 'Corr Speed'), max(s.value) FILTER (WHERE s.channel = 'Ground Speed')) AS \"Speed / reference\"\nFROM samples s WHERE s.run_id = (${reference:sqlstring})::bigint\nAND (${reference:sqlstring})::bigint <> (${run:sqlstring})::bigint\nGROUP BY s.elapsed_s ORDER BY s.elapsed_s",
          "datasourceUid": "osprey_csv"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "velocitykmh",
          "custom": {
            "show": "lines",
            "lineWidth": 2,
            "pointSize": {
              "fixed": 2
